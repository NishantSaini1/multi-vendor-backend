PORT=5000
NODE_ENV=development
API_VERSION=v1

CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:8082,

# MONGO_URI=mongodb://127.0.0.1:27017/multi-vendor-backend
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?appName=multi-vendor-backend

JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_EXPIRES_IN=15m

JWT_ADMIN_EXPIRES_IN=12h
JWT_VENDOR_EXPIRES_IN=24h

JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_REFRESH_EXPIRES_IN=30d

# Convenience only — NOT read by the app. Paste a SUPER_ADMIN access token here
# (from POST /auth/admin/login) for manual testing in Postman/Thunder Client/
# curl. Leave blank in this template; never commit a real token.
TEST_ADMIN_TOKEN=

OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Comma-separated phone numbers that always receive a fixed OTP (TEST_OTP_CODE)
# instead of a random one — for repeatable manual/Postman testing. Never
# honored when NODE_ENV=production, regardless of this config.
TEST_OTP_PHONES=9810000000
TEST_OTP_CODE=123456

REDIS_URL=redis://127.0.0.1:6379

# Nominatim returns 403 for placeholder contacts like contact@example.com —
# use a real app identifier (ideally with a real contact email/URL).
NOMINATIM_USER_AGENT=MultiVendorFoodApp/1.0 (dev build)

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Per phone+IP per 15 min. Keep 5/10 in production; raise locally for testing.
OTP_SEND_RATE_LIMIT_MAX=5
OTP_VERIFY_RATE_LIMIT_MAX=10

LOG_LEVEL=info

BCRYPT_SALT_ROUNDS=12
